copy_field(Authors, author_list)
split_field(author_list, '[|]')
trim(author_list.*)

do list(path:author_list, var:author)
    copy_field(author, mods.name.$append.namePart)
end

do list(path:mods.name)
    add_field(role.roleTerm, author)
end



